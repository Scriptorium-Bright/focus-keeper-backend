{
  "title": "[CS Deep Dive] Big3 Bulk Update Evidence",
  "tags": ["postgres", "cs-audit", "portfolio"],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 38,
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "1. Dead Tuples & AutoVacuum (big3_items)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 18, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "pg_stat_user_tables_n_dead_tup{datname=\"rebootfocus_oom\", schemaname=\"public\", relname=\"big3_items\"}",
          "legendFormat": "Dead Tuples",
          "refId": "A"
        },
        {
          "expr": "increase(pg_stat_user_tables_autovacuum_count{datname=\"rebootfocus_oom\", schemaname=\"public\", relname=\"big3_items\"}[5m])",
          "legendFormat": "AutoVacuum Count (5m)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "2. Lock Waits / Active Sessions",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 9, "x": 0, "y": 9 },
      "targets": [
        {
          "expr": "sum(pg_lock_observation_active_sessions{datname=\"rebootfocus_oom\"})",
          "legendFormat": "Active Sessions",
          "refId": "A"
        },
        {
          "expr": "sum(pg_lock_observation_waiting_sessions{datname=\"rebootfocus_oom\"})",
          "legendFormat": "Lock Waiting Sessions",
          "refId": "B"
        },
        {
          "expr": "sum(increase(pg_stat_database_deadlocks{datname=\"rebootfocus_oom\"}[5m]))",
          "legendFormat": "Deadlocks (5m)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "3. Cache Hit Ratio",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 9, "x": 9, "y": 9 },
      "targets": [
        {
          "expr": "(sum(rate(pg_stat_database_blks_hit{datname=\"rebootfocus_oom\"}[5m])) / clamp_min(sum(rate(pg_stat_database_blks_hit{datname=\"rebootfocus_oom\"}[5m])) + sum(rate(pg_stat_database_blks_read{datname=\"rebootfocus_oom\"}[5m])), 1)) * 100",
          "legendFormat": "Cache Hit Ratio (%)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 3,
            "fillOpacity": 30
          },
          "color": { "fixedColor": "green", "mode": "fixed" }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Last Job Duration",
      "description": "Big3ExpirationJob을 통해 완료된 마지막 실행 시간",
      "type": "stat",
      "gridPos": { "h": 3, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "max(reboot_expiration_last_duration_seconds)",
          "instant": true,
          "legendFormat": "duration",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 180 },
              { "color": "red", "value": 600 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 5,
      "title": "Peak JVM Heap",
      "description": "현재 dashboard 시간 범위에서 rebootfocus-api heap 사용량의 최대값",
      "type": "stat",
      "gridPos": { "h": 3, "w": 6, "x": 18, "y": 3 },
      "targets": [
        {
          "expr": "max_over_time((sum(jvm_memory_used_bytes{area=\"heap\",job=\"rebootfocus-api\"}))[$__range:5s])",
          "instant": true,
          "legendFormat": "peak heap",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 402653184 },
              { "color": "red", "value": 483183820 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 6,
      "title": "GC Count",
      "description": "현재 dashboard 시간 범위에서 발생한 GC pause event 수",
      "type": "stat",
      "gridPos": { "h": 3, "w": 6, "x": 18, "y": 6 },
      "targets": [
        {
          "expr": "sum(max_over_time(jvm_gc_pause_seconds_count{job=\"rebootfocus-api\"}[$__range]) - min_over_time(jvm_gc_pause_seconds_count{job=\"rebootfocus-api\"}[$__range]))",
          "instant": true,
          "legendFormat": "GC count",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 7,
      "title": "GC Pause Total",
      "description": "현재 dashboard 시간 범위의 누적 GC pause 시간",
      "type": "stat",
      "gridPos": { "h": 3, "w": 6, "x": 18, "y": 9 },
      "targets": [
        {
          "expr": "sum(max_over_time(jvm_gc_pause_seconds_sum{job=\"rebootfocus-api\"}[$__range]) - min_over_time(jvm_gc_pause_seconds_sum{job=\"rebootfocus-api\"}[$__range]))",
          "instant": true,
          "legendFormat": "GC pause",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 8,
      "title": "WAL Generated",
      "description": "현재 dashboard 시간 범위에서 PostgreSQL cluster가 생성한 WAL bytes",
      "type": "stat",
      "gridPos": { "h": 3, "w": 6, "x": 18, "y": 12 },
      "targets": [
        {
          "expr": "max_over_time(pg_lock_observation_wal_bytes{datname=\"rebootfocus_oom\"}[$__range]) - min_over_time(pg_lock_observation_wal_bytes{datname=\"rebootfocus_oom\"}[$__range])",
          "instant": true,
          "legendFormat": "WAL",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1073741824 },
              { "color": "red", "value": 5368709120 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 9,
      "title": "Peak Lock Wait",
      "description": "현재 dashboard 시간 범위에서 동시에 lock을 기다린 세션의 최대값",
      "type": "stat",
      "gridPos": { "h": 3, "w": 6, "x": 18, "y": 15 },
      "targets": [
        {
          "expr": "max_over_time(pg_lock_observation_waiting_sessions{datname=\"rebootfocus_oom\"}[$__range])",
          "instant": true,
          "legendFormat": "peak waiting",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    }
  ]
}
